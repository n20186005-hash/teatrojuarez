---
import '../styles/global.css';
const {
  title = 'Teatro Juárez | Guanajuato, México',
  description = 'Guía cultural independiente del Teatro Juárez de Guanajuato: historia, arquitectura, ubicación y consejos para la visita.',
  image = 'https://teatrojuarez.com/images/stage-illustration.svg',
  locale = 'es',
  canonicalPath = Astro.url.pathname,
  robots = 'index,follow',
  i18n = true
} = Astro.props;

const site = Astro.site ?? new URL('https://teatrojuarez.com');
const canonical = new URL(canonicalPath, site).href;
const rawPath = canonicalPath;
let base = rawPath;
if (base.startsWith('/en/')) base = '/' + base.slice(4);
else if (base === '/en' || base === '/en/') base = '/';
const esHref = new URL(base, site).href;
const enHref = new URL(base === '/' ? '/en/' : '/en' + base, site).href;
const alternates = i18n
  ? [
      { lang: 'es', href: esHref },
      { lang: 'en', href: enHref },
      { lang: 'x-default', href: esHref }
    ]
  : [];
const ogLocale = locale === 'es' ? 'es_MX' : 'en_US';
const ogLocaleAlt = locale === 'es' ? 'en_US' : 'es_MX';

const nav = locale === 'es'
  ? [
      ['/#guias', 'Guías'],
      ['/#historia', 'Historia'],
      ['/#arquitectura', 'Arquitectura'],

      ['/#visita', 'Visita']
    ]
  : [
      ['/en/#guides', 'Guides'],
      ['/en/#history', 'History'],
      ['/en/#architecture', 'Architecture'],

      ['/en/#visit', 'Visit']
    ];
const home = locale === 'es' ? '/' : '/en/';
const langLabel = locale === 'es' ? 'EN' : 'ES';
const langHref = locale === 'es' ? enHref : esHref;
const langTitle = locale === 'es' ? 'Read in English' : 'Leer en español';
const footerExplore = locale === 'es'
  ? [
      ['/#guias', 'Guías'],
      ['/#historia', 'Historia'],
      ['/#arquitectura', 'Arquitectura'],

      ['/#visita', 'Cómo llegar'],
      ['/horarios/', 'Horarios'],
      ['/boletos/', 'Boletos'],
      ['/cartelera/', 'Cartelera']
    ]
  : [
      ['/en/#guides', 'Guides'],
      ['/en/#history', 'History'],
      ['/en/#architecture', 'Architecture'],

      ['/en/#visit', 'How to get there'],
      ['/en/horarios/', 'Hours'],
      ['/en/boletos/', 'Tickets'],
      ['/en/cartelera/', 'Program']
    ];
const legal = [
  ['/privacidad/', 'Privacidad', 'Privacy'],
  ['/terminos/', 'Términos', 'Terms'],
  ['/cookies/', 'Cookies', 'Cookies'],
  ['/creditos/', 'Créditos', 'Credits']
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={locale === 'es' ? 'es-MX' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#17120f" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={locale === 'es' ? 'Ilustración abstracta original; no es una fotografía del teatro' : 'Original abstract illustration; not a photograph of the theatre'} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:site_name" content="Teatro Juárez Guanajuato" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="topbar">
      <div class="container"><span>Guanajuato · México</span>{i18n && <span class="topbar-lang"><a href={langHref} hreflang={locale === 'es' ? 'en' : 'es'} title={langTitle}>{langLabel}</a></span>}</div>
    </div>
    <header class:list={["site-header", path !== '/' && path !== '/en/' && 'page-header']}>
      <div class="container nav">
        <a class="brand" href={home} aria-label="Teatro Juárez — inicio / home">
          <span class="brand-mark">TJ</span>
          <strong>Teatro Juárez</strong>
        </a>
        <nav class="navlinks" aria-label="Navegación principal / main navigation">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
          <a class="nav-cta" href="https://maps.app.goo.gl/N6vnCTC4Zi1MfbFF9" target="_blank" rel="noopener noreferrer">{(locale === 'es' ? 'Abrir en Maps' : 'Open in Maps') + ' ↗'}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <h3>Teatro Juárez</h3>
            <p>{locale === 'es'
              ? 'Guía independiente y sin fines de lucro de información turística y divulgación cultural sobre el Teatro Juárez de Guanajuato.'
              : 'An independent, nonprofit tourism and public education information guide to Teatro Juárez in Guanajuato.'}</p>
          </div>
          <div>
            <h4>{locale === 'es' ? 'Explorar' : 'Explore'}</h4>
            {footerExplore.map(([href, label]) => <a href={href}>{label}</a>)}
          </div>
          <div>
            <h4>Legal</h4>
            {legal.map(([href, es, en]) => <a href={href}>{locale === 'es' ? es : en}</a>)}
          </div>
        </div>
        <p class="container">{locale === 'es' ? 'Ilustración geométrica original de esta guía; no representa el teatro.' : 'Original geometric illustration by this guide; does not depict the theatre.'} <a href="/images/stage-illustration.svg">SVG</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a></p>
        <div class="footer-bottom">
          <span>© 2026 {locale === 'es' ? 'Guía independiente del Teatro Juárez.' : 'Independent guide to the Teatro Juárez.'}</span>
          <span>{locale === 'es' ? 'No es el sitio oficial del recinto.' : 'This is not the official site of the theater.'}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
