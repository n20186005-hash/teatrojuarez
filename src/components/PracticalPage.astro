const data = en ? entriesEn[kind] : entriesEs[kind];
const canonicalPath = base + kind + '/';

const extraLabels: Record<string, string> = en
  ? { horarios: 'Opening hours', boletos: 'Tickets', cartelera: 'Programme' }
  : { horarios: 'Horarios', boletos: 'Boletos', cartelera: 'Cartelera' };

function labelFor(slug: string): string {
  const label = en ? guidesEnBySlug[slug]?.h1 : guidesBySlug[slug]?.h1;
  return label ?? extraLabels[slug] ?? slug;
}

const t = en
  ? {
      home: 'Home',
      faq: 'Frequently asked questions',
      sources: 'Official sources and contact',
      related: 'Related pages',
      updated: 'Last verified',
      overview: 'Practical information',
      organization: 'Independent guide to Teatro Juárez',
      disclaimer:
        'This is an independent tourism and cultural information guide. It is not the official site or the box office of Teatro Juárez. Availability and conditions may change; this guide does not book or issue tickets.'
    }
  : {
      home: 'Inicio',
      faq: 'Preguntas frecuentes',
      sources: 'Fuentes oficiales y contacto',
      related: 'Páginas relacionadas',
      updated: 'Última verificación',
      overview: 'Información práctica',
      organization: 'Guía independiente del Teatro Juárez',
      disclaimer:
        'Esta es una guía independiente de información turística y cultural. No es el sitio oficial ni la taquilla del Teatro Juárez. La disponibilidad y las condiciones pueden cambiar; esta guía no reserva ni emite entradas.'
    };

const dateLabel = new Date(data.updated + 'T00:00:00Z').toLocaleDateString(
  en ? 'en-US' : 'es-MX',
  { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }
);

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: en ? 'en' : 'es-MX',
  datePublished: data.updated,
  dateModified: data.updated,
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(canonicalPath, Astro.site).href },
  author: { '@type': 'Organization', name: t.organization, url: 'https://teatrojuarez.com/' },
  publisher: { '@type': 'Organization', name: t.organization, url: 'https://teatrojuarez.com/' },
  about: {
    '@type': ['PerformingArtsTheater', 'TouristAttraction'],
    name: 'Teatro Juárez',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'De Sopena 10, Centro',
      addressLocality: 'Guanajuato',
      addressRegion: 'Guanajuato',
      postalCode: '36000',
      addressCountry: 'MX'
    }
  }
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: new URL(base, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: data.title, item: new URL(canonicalPath, Astro.site).href }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<BaseLayout
  locale={locale}
  canonicalPath={canonicalPath}
  title={data.title}
  description={data.description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(article)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="page-hero">
    <div class="container">
      <nav class="crumbs" aria-label={t.home}>
        <a href={base}>{t.home}</a> <span aria-hidden="true">/</span>
        <span>{en ? 'Plan your visit' : 'Planifica tu visita'}</span>
      </nav>
      <div class="section-label">{en ? 'Plan your visit' : 'Planifica tu visita'}</div>
      <h1>{data.title}</h1>
    </div>
  </section>

  <article class="prose">
    <p class="lead-prose">{data.lead}</p>

    <aside class="facts" aria-label={t.overview}>
      <h2>{t.overview}</h2>
      <dl>
        {data.facts.map((fact) => (
          <div class="fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <a
        class="facts-map"
        href="https://maps.app.goo.gl/N6vnCTC4Zi1MfbFF9"
        target="_blank"
        rel="noopener noreferrer"
      >{en ? 'Open in Google Maps' : 'Abrir en Google Maps'} ↗</a>
    </aside>

    {data.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((p) => <p>{p}</p>)}
        {section.list && (
          <ul>
            {section.list.map((item) => <li>{item}</li>)}
          </ul>
        )}
        {section.note && <p class="note-prose">{section.note}</p>}
      </section>
    ))}

    <h2>{t.faq}</h2>
    <div class="faq">
      {data.faq.map((item) => (
        <div class="faq-item">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </div>

    <h2>{t.sources}</h2>
    <ul class="source-list">
      <li><a href="https://cultura.guanajuato.gob.mx/index.php/teatro-juarez/" target="_blank" rel="noopener noreferrer">Cultura Guanajuato · Teatro Juárez ↗</a></li>
      <li><a href="https://pagosenlinea.guanajuato.gob.mx/catalogo?tema=T027" target="_blank" rel="noopener noreferrer">{en ? 'State finance visit catalogue' : 'Catálogo de visitas de Finanzas'} ↗</a></li>
