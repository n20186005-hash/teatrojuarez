---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { locale: 'es'|'en'; kind: 'horarios'|'boletos'|'cartelera'; }
const {locale,kind}=Astro.props;
const en=locale==='en';
const base=en?'/en/':'/';
const data={
 horarios: en ? {title:'Teatro Juárez opening hours: visits and performances',lead:'No current recurring building-visit schedule was independently established on 29 October 2026. The checked Maps listing showed no opening hours. Check access with the venue before travelling.',heading:'Three different times to check',body:'Building visits, box-office service and performance start times serve different purposes. A time printed on an event ticket is not a daily opening schedule. Rehearsals, technical work and festival arrangements can affect access.',question:'Can I visit today?',answer:'Confirm today’s building access and any last entry with the venue using the official contact or programme links below. This guide cannot confirm same-day availability.'} : {title:'Horarios del Teatro Juárez: visitas y funciones',lead:'No se ha establecido un horario recurrente actual de visitas al edificio al 29 de octubre de 2026. La lista de Maps comprobada no mostraba horarios. Confirma el acceso con el recinto antes de desplazarte.',heading:'Tres horarios que conviene distinguir',body:'Las visitas al edificio, la atención de taquilla y el inicio de cada función son servicios distintos. La hora de un boleto no equivale al horario diario de visita. Ensayos, trabajos técnicos y organización del festival pueden afectar el acceso.',question:'¿Puedo visitar hoy?',answer:'Confirma con el recinto el acceso al edificio y la última entrada del día mediante el contacto o los enlaces oficiales siguientes. Esta guía no puede confirmar disponibilidad para hoy.'},
 boletos: en ? {title:'Teatro Juárez tickets: building visits and shows',lead:'The Guanajuato finance catalogue checked on 29 October 2026 lists general building visits at MXN 62 and preferential visits at MXN 47. These entries are specifically for building visits, not seats at a performance.',heading:'Choose the correct purchase',body:'Confirm that the catalogue fee still applies, which visitors qualify for preferential admission, and whether the building visit is available. For a show, open the specific event’s official listing and follow its purchase link; the price depends on the event and seating category. A nearby commercial tour advertisement is a separate product.',question:'Does MXN 62 include a show?',answer:'No. The checked catalogue describes admission for a visit to Teatro Juárez. Performance tickets have separate event and seating conditions; verify the final price and availability with the organiser.'} : {title:'Boletos del Teatro Juárez: visita y espectáculos',lead:'El catálogo de Finanzas de Guanajuato consultado el 29 de octubre de 2026 muestra visita general de 62 MXN y preferente de 47 MXN. Los conceptos son específicamente por visita al edificio, no por una localidad para función.',heading:'Elige la compra correcta',body:'Confirma la vigencia de la tarifa, quién puede acceder a la preferente y si la visita está disponible. Para un espectáculo, abre la ficha oficial del evento y sigue su enlace de compra; el precio depende de la función y la localidad. Un anuncio de recorrido comercial cercano es otro producto.',question:'¿Los 62 MXN incluyen una función?',answer:'No. El catálogo consultado describe admisión por visita al Teatro Juárez. Los boletos para espectáculos tienen condiciones propias de evento y localidad; verifica precio final y disponibilidad con el organizador.'},
 cartelera: en ? {title:'Teatro Juárez programme: how to check upcoming events',lead:'Use the venue’s official cultural channels and the Cervantino venue page to find the relevant performance. This independent guide does not sell tickets or maintain a live availability feed.',heading:'Check the date, edition and venue',body:'The official Cervantino venue page contains event listings, but a visible listing is not proof of an upcoming show. The checked Adriana Mater page gives 7 and 8 October with 2026 discount conditions: those dates are already past as of this review. Check the year and full date of the event you choose, then its venue, time, seating and purchase conditions.',question:'Are the listed October shows upcoming?',answer:'Not necessarily. Official event pages may remain visible after their dates. Check the complete date and edition, and ask the organiser if availability is unclear.'} : {title:'Cartelera del Teatro Juárez: consulta funciones próximas',lead:'Consulta los canales culturales oficiales y la página del recinto en el Cervantino para encontrar la función correspondiente. Esta guía independiente no vende boletos ni ofrece disponibilidad en directo.',heading:'Comprueba fecha, edición y recinto',body:'La página oficial del recinto en el Cervantino contiene fichas de eventos, pero una ficha visible no demuestra una función futura. La ficha consultada de Adriana Mater indica 7 y 8 de octubre con condiciones de descuento de 2026: esas fechas ya pasaron al revisar esta guía. Comprueba año y fecha completa del evento elegido, y después recinto, hora, localidad y condiciones de compra.',question:'¿Las funciones de octubre siguen próximas?',answer:'No necesariamente. Las fichas oficiales pueden permanecer publicadas después de la función. Comprueba fecha completa y edición; si no está clara la disponibilidad, consulta al organizador.'}
}[kind];
const canonicalPath=base+kind+'/';
const faq={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[{'@type':'Question',name:data.question,acceptedAnswer:{'@type':'Answer',text:data.answer}}]};
---
<BaseLayout locale={locale} canonicalPath={canonicalPath} title={data.title} description={data.lead}>
 <script slot="head" type="application/ld+json" set:html={JSON.stringify(faq)} />
 <section class="page-hero"><div class="container"><div class="section-label">{en?'Visitor planning':'Planifica tu visita'}</div><h1>{data.title}</h1></div></section>
 <article class="prose"><p>{data.lead}</p><h2>{data.heading}</h2><p>{data.body}</p><h2>{en?'Official sources and contact':'Fuentes oficiales y contacto'}</h2><ul>
 <li><a href="https://cultura.guanajuato.gob.mx/index.php/teatro-juarez/">Cultura Guanajuato · Teatro Juárez</a></li>
 <li><a href="https://pagosenlinea.guanajuato.gob.mx/catalogo?tema=T027">{en?'State finance visit catalogue':'Catálogo de visitas de Finanzas'}</a></li>
 <li><a href="https://festivalcervantino.gob.mx/recinto/6/juarez-theater?lan=es">Festival Internacional Cervantino · Teatro Juárez</a></li>
 {kind==='cartelera' && <li><a href="https://festivalcervantino.gob.mx/actividad/146/adriana-mater-de-kaija-saariaho">Adriana Mater · {en?'dated example, not an upcoming-event promise':'ejemplo fechado, no promesa de función próxima'}</a></li>}
 <li><a href="tel:+524737322521">+52 473 732 2521</a> · {en?'Venue contact listed by the festival':'Contacto del recinto publicado por el festival'}</li></ul>
 <h2>{en?'Frequently asked question':'Pregunta frecuente'}</h2><h3>{data.question}</h3><p>{data.answer}</p><p>{en?'Sources checked 29 October 2026; availability and conditions may change. This guide does not book or issue tickets.':'Fuentes consultadas el 29 de octubre de 2026; disponibilidad y condiciones pueden cambiar. Esta guía no reserva ni emite entradas.'}</p>
 <nav class="related" aria-label={en?'Related pages':'Páginas relacionadas'}>{(['horarios','boletos','cartelera'] as const).filter(k=>k!==kind).map(k=><a href={base+k+'/'}>{({horarios:en?'Hours':'Horarios',boletos:en?'Tickets':'Boletos',cartelera:en?'Programme':'Cartelera'})[k]}</a>)}<a href={base}>{en?'Visitor guide':'Guía de visita'}</a></nav></article>
</BaseLayout>
