---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guidesBySlug } from '../data/guides';
import { guidesEnBySlug } from '../data/guides/en';
import type { GuideSection, GuideFaq, GuideFact } from '../data/guides/types';

interface Props {
  locale: 'es' | 'en';
  kind: 'horarios' | 'boletos' | 'cartelera';
}

const { locale, kind } = Astro.props;
const en = locale === 'en';
const base = en ? '/en/' : '/';

interface Entry {
  title: string;
  description: string;
  lead: string;
  facts: GuideFact[];
  sections: GuideSection[];
  faq: GuideFaq[];
  related: string[];
  updated: string;
}

const UPDATED = '2026-11-04';

const entriesEs: Record<Props['kind'], Entry> = {
  horarios: {
    title: 'Horarios del Teatro Juárez: visitas y funciones',
    description:
      'Qué horarios conviene distinguir en el Teatro Juárez y cómo confirmar el acceso del día, ya que no existe un horario de visitas permanente verificado.',
    lead: 'No se ha establecido un horario recurrente actual de visitas al edificio al 4 de noviembre de 2026. La lista de Maps comprobada no mostraba horarios. Confirma el acceso con el recinto antes de desplazarte.',
    facts: [
      { label: 'Dirección', value: 'De Sopena 10, Centro, 36000 Guanajuato, Gto.' },
      { label: 'Teléfono del recinto', value: '+52 473 732 2521' },
      { label: 'Visitas al edificio', value: 'Sin horario recurrente verificado; se confirma el mismo día.' },
    ],
    sections: [
      {
        heading: 'Tres horarios que conviene distinguir',
        paragraphs: [
          'Las visitas al edificio, la atención de taquilla y el inicio de cada función son servicios distintos. La hora de un boleto no equivale al horario diario de visita. Ensayos, trabajos técnicos y la organización del festival pueden afectar al acceso.',
        ],
        list: [
          'Visita al edificio: cuándo puede entrarse a ver el vestíbulo y la sala.',
          'Taquilla: cuándo hay atención para comprar o preguntar.',
          'Función: la hora exacta a la que empieza el espectáculo de tu localidad.',
        ],
      },
      {
        heading: 'Cómo confirmar el acceso del día',
        paragraphs: [
          'El acceso depende de la programación, así que se comprueba el mismo día. No publicamos una franja horaria fija porque no hemos podido verificar una vigente.',
        ],
        list: [
          'Llama al recinto: +52 473 732 2521.',
          'Consulta la página de Cultura Guanajuato del teatro.',
          'Revisa la ficha del recinto en el Festival Cervantino si hay actividad programada.',
          'Pregunta si el acceso incluye la sala principal o solo áreas concretas.',
        ],
      },
      {
        heading: 'Si vas a una función',
        paragraphs: [
          'El horario que figura en tu boleto es el de la función, no un horario de visita. Muchas salas restringen la entrada una vez iniciado el espectáculo, y el centro histórico es de cuestas y callejones, por lo que conviene llegar con margen.',
          'Para planear ese día, consulta la guía de consejos para asistir y la de cómo llegar.',
        ],
      },
    ],
    faq: [
      {
        q: '¿Puedo visitar hoy?',
        a: 'Confirma con el recinto el acceso al edificio y la última entrada del día mediante el contacto o los enlaces oficiales. Esta guía no puede confirmar disponibilidad para hoy.',
      },
