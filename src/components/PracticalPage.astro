    updated: UPDATED,
  },
  boletos: {
    title: 'Boletos del Teatro Juárez: visita y espectáculos',
    description:
      'Diferencia entre la entrada de visita al Teatro Juárez y el boleto de una función, qué tarifas constan y cómo comprar sin intermediarios.',
    lead: 'El catálogo de Finanzas de Guanajuato consultado el 4 de noviembre de 2026 muestra visita general de 62 MXN y preferente de 47 MXN. Los conceptos son específicamente por visita al edificio, no por una localidad para función.',
    facts: [
      { label: 'Visita general', value: '62 MXN (catálogo oficial; confirma vigencia)' },
      { label: 'Visita preferente', value: '47 MXN (catálogo oficial; confirma vigencia)' },
