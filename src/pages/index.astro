---
import BaseLayout from '../layouts/BaseLayout.astro';

const facade = 'https://upload.wikimedia.org/wikipedia/commons/a/a4/Teatro_Juarez_Fachada.jpg';
const night = 'https://upload.wikimedia.org/wikipedia/commons/5/5a/Teatro_Ju%C3%A1rez_de_noche.JPG';
const interior = 'https://upload.wikimedia.org/wikipedia/commons/8/89/Interior_of_Teatro_Juarez_Main_Auditorium_-_Guanajuato_-_Mexico_-_01_%2839138645172%29.jpg';
const lobby = 'https://upload.wikimedia.org/wikipedia/commons/4/48/Teatro_Ju%C3%A1rez%2C_Guanajuato_09_-_Esculturas_del_lobby.jpg';
const panorama = 'https://upload.wikimedia.org/wikipedia/commons/d/d5/Panorama_of_Interior_of_Teatro_Juarez_Main_Auditorium_-_Guanajuato_-_Mexico_%2839168803691%29.jpg';

const schema = {
  '@context': 'https://schema.org',
  '@type': ['PerformingArtsTheater', 'TouristAttraction'],
  '@id': 'https://teatrojuarez.com/#theater',
  name: 'Teatro Juárez',
  alternateName: ['华雷斯剧院', 'Juárez Theatre', 'Teatro Juarez'],
  description: 'Teatro histórico de Guanajuato inaugurado en 1903, reconocido por su fachada clasicista y su sala de inspiración neomudéjar.',
  telephone: '+52 473 732 2521',
  url: 'https://teatrojuarez.com/',
  isAccessibleForFree: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'De Sopena 10, Centro',
    addressLocality: 'Guanajuato',
    addressRegion: 'Guanajuato',
    postalCode: '36000',
    addressCountry: 'MX'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 21.0153,
    longitude: -101.2529
  },
  hasMap: 'https://maps.app.goo.gl/N6vnCTC4Zi1MfbFF9',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: 19280,
    bestRating: '5',
    worstRating: '1'
  },
  sameAs: [
    'https://maps.app.goo.gl/N6vnCTC4Zi1MfbFF9',
    'https://cultura.guanajuato.gob.mx/index.php/teatro-juarez/',
    'https://catalogonacionalmhi.inah.gob.mx/consulta_publica/detalle/18296'
  ]
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Teatro Juárez Guanajuato',
  url: 'https://teatrojuarez.com/',
  inLanguage: 'es-MX'
};

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cuál es el horario del Teatro Juárez?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El Teatro Juárez no tiene un horario único fijo porque funciona como recinto de artes escénicas y monumento histórico. Los accesos para visitas, visitas guiadas y funciones cambian según la temporada y la programación. Confirma el horario del día en los canales oficiales antes de desplazarte.'
      }
    },
    {
      '@type': 'Question',
      name: '¿Dónde compro boletos para el Teatro Juárez?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Las entradas para funciones y, en su caso, las visitas guiadas se gestionan a través de los canales oficiales del recinto y del Instituto Estatal de la Cultura de Guanajuato. Esta guía no vende boletos; compra siempre por la vía oficial para evitar intermediarios.'
      }
    },
    {
      '@type': 'Question',
      name: '¿Qué tipo de eventos presenta el Teatro Juárez?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El teatro alberga ópera, conciertos, danza, teatro y ciclos culturales a lo largo del año, con un papel protagonista durante el Festival Internacional Cervantino.'
      }
    },
    {
      '@type': 'Question',
      name: '¿Dónde está y cómo llego al Teatro Juárez?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Está en De Sopena 10, Centro, 36000 Guanajuato, Gto. Se encuentra en el centro histórico, cerca de otros puntos turísticos. Puedes abrir la ubicación exacta en Google Maps para planear tu ruta.'
      }
    }
  ]
};
---
<BaseLayout
  locale="es"
  canonicalPath="/"
  title="Teatro Juárez Guanajuato: visita, horarios y cartelera"
  description="Guía del Teatro Juárez en Guanajuato: historia, arquitectura, cómo llegar, horarios, boletos y cartelera de eventos."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(website)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faq)} />

  <section class="hero" style={`--hero-image:url('${night}')`}>
    <div class="container hero-grid">
      <div>
        <div class="kicker">Escena · Arquitectura · Memoria</div>
        <h1>Teatro<br />Juárez <em>Guanajuato, México</em></h1>
        <p class="hero-copy">Una fachada solemne de doce columnas, ocho musas de bronce y un interior que cambia el clasicismo por la fantasía neomudéjar. Desde 1903, el teatro es uno de los grandes símbolos culturales de la ciudad.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#visita">Planear la visita</a>
          <a class="btn btn-ghost" href="https://maps.app.goo.gl/N6vnCTC4Zi1MfbFF9" target="_blank" rel="noopener noreferrer">Ver en Google Maps ↗</a>
        </div>
      </div>
      <aside class="hero-card" aria-label="Información rápida">
        <div class="rating"><div><div class="kicker" style="margin:0 0 4px">Valoración en Maps</div><strong>4.8</strong></div><span>19,280 reseñas*</span></div>
        <dl>
          <div><dt>Tipo</dt><dd>Teatro histórico · recinto de artes escénicas</dd></div>
          <div><dt>Dirección</dt><dd>De Sopena 10, Centro, 36000 Guanajuato, Gto.</dd></div>
          <div><dt>Teléfono</dt><dd><a href="tel:+524737322521">+52 473 732 2521</a></dd></div>
          <div><dt>Inauguración</dt><dd>27 de octubre de 1903</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="dark-band" id="historia">
    <div class="container section-grid">
      <div>
        <div class="section-label">Una obra de décadas</div>
        <h2 class="section-title">Del antiguo convento a un emblema urbano.</h2>
      </div>
      <div>
        <p class="lead">La construcción comenzó en 1873 sobre el solar vinculado al antiguo convento de San Diego de Alcalá. El proyecto inicial de José María Noriega fue retomado y transformado por Antonio Rivas Mercado, con Alberto Malo en la etapa final.</p>
        <p class="copy">El teatro abrió formalmente el 27 de octubre de 1903. Su estreno fue una representación de <em>Aída</em>, de Giuseppe Verdi. Desde entonces ha funcionado tanto como sala de espectáculos como pieza central del paisaje cultural del centro histórico de Guanajuato.</p>
      </div>
    </div>
  </section>

  <div class="stats" aria-label="Datos arquitectónicos destacados">
    <div class="stat"><strong>1873</strong><span>Inicio de la obra</span></div>
    <div class="stat"><strong>1903</strong><span>Inauguración</span></div>
    <div class="stat"><strong>12</strong><span>Columnas del pórtico</span></div>
    <div class="stat"><strong>8</strong><span>Musas de bronce</span></div>
  </div>

  <section class="section" id="galeria">
    <div class="container">
      <div class="section-heading">
        <h2>El teatro<br /><em>en detalle</em></h2>
        <p>La experiencia cambia por completo al atravesar el pórtico: cantera y bronce al exterior; geometría, dorados, madera y una intensa ornamentación en la sala.</p>
      </div>
      <div class="gallery-grid">
        <figure class="photo-card large">
          <img src={facade} alt="Fachada y columnas del Teatro Juárez en Guanajuato" loading="lazy" />
          <figcaption class="photo-caption"><small>Exterior</small><strong>El pórtico clasicista</strong></figcaption>
        </figure>
        <div class="gallery-stack">
          <figure class="photo-card">
            <img src={interior} alt="Interior ornamentado de la sala principal del Teatro Juárez" loading="lazy" />
            <figcaption class="photo-caption"><small>Sala principal</small><strong>Ornamento neomudéjar</strong></figcaption>
          </figure>
          <figure class="photo-card">
            <img src={lobby} alt="Escultura decorativa en el interior del Teatro Juárez" loading="lazy" />
            <figcaption class="photo-caption"><small>Interiores</small><strong>Escultura y artes decorativas</strong></figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="architecture" id="arquitectura">
    <div class="container">
      <div class="arch-image"><img src={panorama} alt="Panorámica del interior de la sala principal del Teatro Juárez" loading="lazy" /></div>
      <div class="arch-content">
        <div class="section-label">Arquitectura ecléctica</div>
        <h2>Un diálogo entre lo clásico y lo neomudéjar.</h2>
        <p>La fachada presenta una monumentalidad clasicista, mientras que la sala principal despliega una decoración historicista de inspiración hispanomusulmana. Esa tensión entre lenguajes es parte de la identidad del edificio.</p>
        <div class="feature-list">
          <div class="feature"><b>01</b><p><strong>Pórtico.</strong> Doce columnas estriadas organizan el acceso monumental.</p></div>
          <div class="feature"><b>02</b><p><strong>Musas.</strong> Ocho esculturas de bronce coronan la balaustrada superior.</p></div>
          <div class="feature"><b>03</b><p><strong>Sala.</strong> Arcos, lacerías y motivos geométricos construyen el ambiente neomudéjar.</p></div>
          <div class="feature"><b>04</b><p><strong>Telón.</strong> La decoración histórica del recinto incluye un telón realizado por el artista francés Labasta.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="visita">
    <div class="container visit">
      <aside class="info-panel">
        <div class="section-label">Información práctica</div>
        <h2>Visita el Teatro Juárez</h2>
        <div class="info-row"><small>Dirección</small>De Sopena 10, Centro, 36000 Guanajuato, Gto., México</div>
        <div class="info-row"><small>Teléfono</small><a href="tel:+524737322521">+52 473 732 2521</a></div>
        <div class="info-row"><small>Plus Code</small>2P8W+5R · Guanajuato, Gto.</div>
        <div class="info-row"><small>Google Maps</small><a href="https://maps.app.goo.gl/N6vnCTC4Zi1MfbFF9" target="_blank" rel="noopener noreferrer">Abrir ubicación ↗</a></div>
        <div class="notice">Los horarios de visita, acceso a la sala y tarifas pueden cambiar por funciones, montajes o programación especial. Conviene confirmarlos con el recinto antes de desplazarse.</div>
      </aside>
      <div class="map-wrap">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6619.593719850613!2d-101.25547602298793!3d21.015443788232353!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x842b7407ef067b45%3A0xa7f4cdbcd8596dcd!2z5Y2O6Zu35pav5Ymn6Zmi!5e1!3m2!1szh-CN!2sus!4v1789008475330!5m2!1szh-CN!2sus" title="Mapa del Teatro Juárez" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </div>
  </section>

  <section class="section" id="practico">
    <div class="container">
      <div class="section-heading">
        <h2>Horarios,<br /><em>boletos y cartelera</em></h2>
        <p>El Teatro Juárez combina su faceta de monumento histórico con una programación vigente de artes escénicas. Esto responde a las dudas más frecuentes antes de la visita.</p>
      </div>
      <div class="intent-grid">
        <div class="intent-card">
          <h3>Horarios de visita y funciones</h3>
          <p>Como recinto activo, los horarios de acceso a la sala, las visitas guiadas y las funciones cambian según la temporada y la cartelera. Lo habitual es que las visitas turísticas se concentren en el día y los espectáculos por la noche.</p>
          <p class="intent-note">Confirma el horario del día en los canales oficiales antes de desplazarte; esta guía no vende ni reserva accesos.</p>
          <a class="intent-more" href="/horarios/">Horarios y visitas →</a>
        </div>
        <div class="intent-card">
          <h3>Boletos y entradas</h3>
          <p>Las entradas para funciones y, en su caso, las visitas guiadas, se gestionan a través de los canales oficiales del recinto y del Instituto Estatal de la Cultura de Guanajuato. Los precios dependen de cada evento o modalidad de visita.</p>
          <p class="intent-note">No emitimos boletos. Compra siempre por la vía oficial para evitar intermediarios.</p>
          <a class="intent-more" href="/boletos/">Boletos y entradas →</a>
        </div>
        <div class="intent-card">
          <h3>Cartelera de eventos</h3>
          <p>El teatro alberga ópera, conciertos, danza, teatro y ciclos culturales a lo largo del año, con especial protagonismo durante el Festival Internacional Cervantino.</p>
          <ul class="source-list">
            <li><a href="https://cultura.guanajuato.gob.mx/index.php/teatro-juarez/" target="_blank" rel="noopener noreferrer">Cultura Guanajuato · Teatro Juárez ↗</a></li>
            <li><a href="tel:+524737322521">+52 473 732 2521</a></li>
          </ul>
          <a class="intent-more" href="/cartelera/">Cartelera de eventos →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-heading">
        <h2>Preguntas<br /><em>frecuentes</em></h2>
        <p>Respuestas honestas a las dudas más comunes antes de visitar el Teatro Juárez.</p>
      </div>
      <div class="faq">
        <div class="faq-item"><h3>¿Cuál es el horario del Teatro Juárez?</h3><p>El Teatro Juárez no tiene un horario único fijo porque funciona como recinto de artes escénicas y monumento histórico. Los accesos para visitas, visitas guiadas y funciones cambian según la temporada y la programación. Confirma el horario del día en los canales oficiales antes de desplazarte.</p></div>
        <div class="faq-item"><h3>¿Dónde compro boletos para el Teatro Juárez?</h3><p>Las entradas para funciones y, en su caso, las visitas guiadas se gestionan a través de los canales oficiales del recinto y del Instituto Estatal de la Cultura de Guanajuato. Esta guía no vende boletos; compra siempre por la vía oficial para evitar intermediarios.</p></div>
        <div class="faq-item"><h3>¿Qué tipo de eventos presenta el Teatro Juárez?</h3><p>El teatro alberga ópera, conciertos, danza, teatro y ciclos culturales a lo largo del año, con un papel protagonista durante el Festival Internacional Cervantino.</p></div>
        <div class="faq-item"><h3>¿Dónde está y cómo llego al Teatro Juárez?</h3><p>Está en De Sopena 10, Centro, 36000 Guanajuato, Gto. Se encuentra en el centro histórico, cerca de otros puntos turísticos. Puedes abrir la ubicación exacta en Google Maps para planear tu ruta.</p></div>
      </div>
      <nav class="related" aria-label="Páginas relacionadas">
        <a href="/horarios/">Horarios →</a>
        <a href="/boletos/">Boletos y entradas →</a>
        <a href="/cartelera/">Cartelera de eventos →</a>
      </nav>
    </div>
  </section>

  <section class="section" style="background:#efe4d3">
    <div class="container section-grid">
      <div>
        <div class="section-label">Fuentes verificadas</div>
        <h2 class="section-title">Historia con respaldo institucional.</h2>
      </div>
      <div>
        <p>La información histórica y arquitectónica de esta guía se contrastó con fuentes culturales del Gobierno del Estado de Guanajuato y con el Catálogo Nacional de Monumentos Históricos Inmuebles del INAH.</p>
        <ul class="source-list">
          <li><a href="https://cultura.guanajuato.gob.mx/index.php/teatro-juarez/" target="_blank" rel="noopener noreferrer">Cultura Guanajuato · Teatro Juárez ↗</a></li>
          <li><a href="https://catalogonacionalmhi.inah.gob.mx/consulta_publica/detalle/18296" target="_blank" rel="noopener noreferrer">INAH · Catálogo Nacional de Monumentos Históricos ↗</a></li>
          <li><a href="https://inah.gob.mx/foto-del-dia/teatro-juarez-un-faro-cultural-guanajuatense" target="_blank" rel="noopener noreferrer">INAH · Teatro Juárez: un faro cultural guanajuatense ↗</a></li>
        </ul>
        <p style="font-size:.8rem;color:#76685e;margin-top:24px">* La valoración y el número de reseñas corresponden a los datos de Google Maps proporcionados para esta edición de la guía.</p>
      </div>
    </div>
  </section>
</BaseLayout>
