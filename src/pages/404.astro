---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada | Teatro Juárez — Guía independiente" description="La página solicitada no existe." i18n={false}>
  <section class="page-hero">
    <div class="container">
      <div class="section-label">Error 404</div>
      <h1>El telón cayó antes de tiempo.</h1>
    </div>
  </section>
  <article class="prose">
    <p>La página que buscas no existe o cambió de dirección.</p>
    <p><a class="btn btn-primary" href="/">Volver al Teatro Juárez</a></p>
  </article>
</BaseLayout>
